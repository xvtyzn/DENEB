exports[`renderSVG > adc-igg matches its snapshot 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 272 241.54" width="272" height="241.54" role="img" class="deneb"><title>ADC (interchain-cysteine conjugate)</title><desc>Antibody format diagram: 4 chains, targets HER2.</desc><text x="136" y="14" font-size="12" font-family="ui-sans-serif, -apple-system, 'Helvetica Neue', 'Hiragino Sans', 'Noto Sans JP', Arial, sans-serif" font-weight="600" text-anchor="middle" class="dn-title" fill="#1c222b">ADC (interchain-cysteine conjugate)</text><g class="dn-molecule" transform="translate(136,99.04)"><g class="dn-connectors"><path d="M-23.07,-33.32 L-22.28,-32.05" class="dn-connector dn-connector-backbone" fill="none" stroke="#4a5261" stroke-width="1.6" stroke-linecap="round" pointer-events="none" data-connector-kind="backbone" data-domain-a="HC:0" data-domain-b="HC:1"/><path d="M-8.5,-10 L-8.5,0" class="dn-connector dn-connector-hinge" fill="none" stroke="#4a5261" stroke-width="2.2" stroke-linecap="round" pointer-events="none" data-connector-kind="hinge" data-domain-a="HC:1" data-domain-b="HC:3"/><path d="M-8.5,26 L-8.5,27.5" class="dn-connector dn-connector-backbone" fill="none" stroke="#4a5261" stroke-width="1.6" stroke-linecap="round" pointer-events="none" data-connector-kind="backbone" data-domain-a="HC:3" data-domain-b="HC:4"/><path d="M23.07,-33.32 L22.28,-32.05" class="dn-connector dn-connector-backbone" fill="none" stroke="#4a5261" stroke-width="1.6" stroke-linecap="round" pointer-events="none" data-connector-kind="backbone" data-domain-a="HC(2):0" data-domain-b="HC(2):1"/><path d="M8.5,-10 L8.5,0" class="dn-connector dn-connector-hinge" fill="none" stroke="#4a5261" stroke-width="2.2" stroke-linecap="round" pointer-events="none" data-connector-kind="hinge" data-domain-a="HC(2):1" data-domain-b="HC(2):3"/><path d="M8.5,26 L8.5,27.5" class="dn-connector dn-connector-backbone" fill="none" stroke="#4a5261" stroke-width="1.6" stroke-linecap="round" pointer-events="